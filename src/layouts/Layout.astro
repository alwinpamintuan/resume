---
import '../styles/global.css';
import type { Resume } from '../lib/content';
import ThemeToggle from '../components/ThemeToggle.astro';
import { sitePath } from '../lib/urls';

interface Props { content: Resume; title?: string; description?: string; noindex?: boolean; document?: boolean }
const { content, title, description = content.profile.summary, noindex = false, document = false } = Astro.props;
const pageTitle = title ? `${title} · ${content.profile.name}` : `${content.profile.name} · ${content.profile.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f2ec" />
    { (content.sample || noindex) && <meta name="robots" content="noindex, nofollow" /> }
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[document && 'document-page']}>
    <a class="skip-link" href="#main">Skip to content</a>
    {content.sample && <div class="sample-banner"><span class="sample-dot" aria-hidden="true"></span> Sample edition <span class="sample-note">— career details, projects, and results are fictional.</span></div>}
    <div class="shell">
      <header class="site-header">
        <a class="site-home" href={sitePath('#top')}>Résumé</a>
        <div class="header-actions"><nav aria-label="Primary">{content.sections.some((section) => section.id === 'experience' && section.visible) && content.experience.length > 0 && <a href={sitePath('#experience')}>Experience</a>}{content.sections.some((section) => section.id === 'selected' && section.visible) && content.work.some((work) => work.visible && work.placement === 'selected') && <a href={sitePath('#selected')}>Work</a>}<a class="header-contact" href={`mailto:${content.profile.email}`}>Contact</a></nav><ThemeToggle /></div>
      </header>
      <slot />
      <footer class="site-footer"><a href={sitePath()}>{content.profile.name}</a><a href="#top">Back to top <span aria-hidden="true">↑</span></a></footer>
    </div>
  </body>
</html>
