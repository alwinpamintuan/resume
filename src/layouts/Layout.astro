---
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import sansRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/site-tokens.css';
import '../styles/global.css';
import '../styles/site-chrome.css';
import '../styles/site-transitions.css';
import type { Resume } from '../lib/content';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sitePath } from '../lib/urls';

interface Props { content: Resume; title?: string; description?: string; noindex?: boolean; document?: boolean; sections?: readonly { id: string; label: string }[] }
const { content, title, description = content.profile.summary, noindex = false, document = false, sections = [] } = Astro.props;
const pageTitle = title ? `${title} · ${content.profile.name}` : `${content.profile.name} · ${content.profile.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={sansRegular} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f2ec" />
    { (content.sample || noindex) && <meta name="robots" content="noindex, nofollow" /> }
    <script is:inline>
      (() => {
        let preference;
        try {
          const saved = localStorage.getItem('personal-site:theme') ?? localStorage.getItem('project-index:theme');
          if (saved === 'light' || saved === 'dark') { preference = saved; localStorage.setItem('personal-site:theme', saved); }
        } catch { /* Storage restrictions do not prevent theme selection. */ }
        const theme = preference ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (preference) {
          document.documentElement.dataset.theme = preference;
          document.documentElement.dataset.themePreference = preference;
        }
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#20201e' : '#f3f2ec');
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[document && 'document-page']}>
    <a class="skip-link" href="#main">Skip to content</a>
    {content.sample && <div class="sample-banner"><span class="sample-dot" aria-hidden="true"></span> Sample edition <span class="sample-note">— career details, projects, and results are fictional.</span></div>}
    <div class="shell">
      <header class="site-header">
        <a class="site-home" href={new URL('/', Astro.site).href}>{content.profile.name}</a>
        {sections.length > 0 && <details class="page-menu">
          <summary aria-label="Page sections"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h9" /></svg></summary>
          <nav class="header-nav" data-section-nav aria-label="On this page">
            {sections.map((section) => <a href={'#' + section.id}>{section.id === 'expertise' ? 'Skills' : section.label}</a>)}
          </nav>
        </details>}
        <ThemeToggle />
      </header>
      <slot />
      <SiteFooter profiles={content.profile.links} email={content.profile.email} topHref="#top" />
    </div>
    <script src="../scripts/site-navigation.ts"></script>
  </body>
</html>
