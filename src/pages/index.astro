---
import Layout from '../layouts/Layout.astro';
import ResumeDocument from '../components/ResumeDocument.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Pipeline from '../components/Pipeline.astro';
import Skills from '../components/Skills.astro';
import { loadContent, displayDate, workHref } from '../lib/content';
const content = loadContent();
function linkIcon(url: string): 'github' | 'linkedin' | undefined {
  const host = new URL(url).hostname.replace(/^www\./, '');
  return host === 'github.com' ? 'github' : host === 'linkedin.com' ? 'linkedin' : undefined;
}
const selected = content.work.filter((item) => item.visible && item.placement === 'selected');
const other = content.work.filter((item) => item.visible && item.placement === 'other');
const populated = { experience: content.experience.length, selected: selected.length, other: other.length, expertise: content.expertise.length, certifications: content.certifications.length, principles: content.principles.length, education: content.education.length };
const sections = content.sections.filter((section) => section.visible && populated[section.id] > 0);
---
<Layout content={content}>
  <main id="main" class="portfolio-main">
    <section class="hero" id="top" aria-labelledby="intro-title">
      <p class="hero-label eyebrow">{content.profile.title} / portfolio</p>
      <div class="hero-title"><h1 id="intro-title"><span>{content.profile.name}</span></h1><p class="profile-line">{content.profile.title}{content.profile.location && <> <span aria-hidden="true">·</span> {content.profile.location}</>}</p><p class="intro">{content.profile.summary}</p><div class="hero-actions"><a class="text-link" href="/resume/">View résumé</a><a class="text-link" href={`/downloads/${content.profile.documentName}.pdf`} download>Download résumé <span aria-hidden="true">↓</span></a></div><div class="social-links">{content.profile.links.map((link) => <a href={link.url}><SocialIcon name={linkIcon(link.url)} />{link.label}</a>)}<a href={`mailto:${content.profile.email}`}><SocialIcon name="mail" />Email</a></div></div>
    </section>
    {sections.map((section, index) => <section class:list={['resume-section', 'portfolio-section', `section-${section.id}`]} id={section.id} aria-labelledby={`${section.id}-title`}>
      <div class="section-rail"><span class="section-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h2 id={`${section.id}-title`}>{section.label}</h2></div>
      <div class="section-content">
        {section.id === 'experience' && content.experience.map((job) => <article class="experience" id={job.id}><div class="company-heading"><h3>{job.company}</h3>{job.location && <span class="meta">{job.location}</span>}</div><div class="roles">{job.roles.map((role) => <div class="role"><div class="role-heading"><h4>{role.title}</h4><span class="meta">{displayDate(role.start)} — {displayDate(role.end)}</span></div>{role.scope && <p>{role.scope}</p>}{role.highlights.length > 0 && <ul>{role.highlights.map((highlight) => <li id={highlight.id}>{highlight.text}</li>)}</ul>}</div>)}</div></article>)}
        {section.id === 'selected' && selected.map((work) => <article class="selected-work" id={work.id}><div class="work-copy"><div class="work-meta"><span class="eyebrow">{work.type}</span><span class="meta">{work.year}</span></div><h3>{workHref(work) ? <a href={workHref(work)}>{work.title}<span aria-hidden="true"> ↗</span></a> : work.title}</h3><p>{work.summary}</p><ul class="tags" aria-label="Technologies">{work.technologies.map((technology) => <li>{technology}</li>)}</ul>{workHref(work) && <a class="text-link" href={workHref(work)}>Read notes <span aria-hidden="true">→</span></a>}</div>{work.details?.screenshot ? <figure class="project-screenshot"><img src={work.details.screenshot.src} alt={work.details.screenshot.alt} width="1000" height="580" loading="lazy" decoding="async" /></figure> : work.details?.pipeline && <Pipeline pipeline={work.details.pipeline} />}</article>)}
        {section.id === 'other' && other.map((work) => <article class="other-work" id={work.id}><div><h3>{workHref(work) ? <a href={workHref(work)}>{work.title} <span aria-hidden="true">↗</span></a> : work.title}</h3><p>{work.summary}</p></div><span class="meta">{work.year}</span></article>)}
        {section.id === 'expertise' && <Skills content={content} />}
        {section.id === 'certifications' && content.certifications.map((item) => <article class="certification"><h3>{item.name}</h3><p>{item.issuer}</p>{(item.issued || item.expires) && <p class="meta">{item.issued && <>Issued {displayDate(item.issued)}</>}{item.issued && item.expires && ' · '}{item.expires && <>Expires {displayDate(item.expires)}</>}</p>}{item.credentialUrl && <a class="text-link" href={item.credentialUrl}>View credential <span aria-hidden="true">↗</span><span class="visually-hidden"> for {item.name}</span></a>}</article>)}
        {section.id === 'principles' && <div class="principles">{content.principles.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>}
        {section.id === 'education' && content.education.map((item) => <div class="education"><h3>{item.qualification}</h3><p>{item.institution}</p><span class="meta">{item.year}</span>{item.highlights.length > 0 && <ul class="education-highlights">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}</div>)}
      </div>
    </section>)}
    <section class="contact-end" aria-label="Contact"><p>Contact</p><a href={`mailto:${content.profile.email}`}>{content.profile.email}</a></section>
    <div class="print-only"><ResumeDocument content={content} profile={content.exports.profiles.find((item) => item.id === content.exports.default)!} /></div>
  </main>
</Layout>
