---
import Layout from '../layouts/Layout.astro';
import { loadContent } from '../lib/content';
const content = loadContent();
---
<Layout content={content} title="Page not found" noindex><main id="main" class="not-found"><p class="eyebrow" id="top">404</p><h1>This page isn’t here.</h1><p>The link may have changed. You can find my résumé and selected work on the main page.</p><a class="button" href="/">Back to portfolio →</a></main></Layout>
