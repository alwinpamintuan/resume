---
import type { GetStaticPaths } from 'astro';
import { sitePath } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import Pipeline from '../components/Pipeline.astro';
import { loadContent, type Work } from '../lib/content';
export const getStaticPaths = (() => loadContent().work.filter((work) => work.visible && work.slug).map((work) => ({ params: { slug: work.slug }, props: { work } }))) satisfies GetStaticPaths;
interface Props { work: Work }
const { work } = Astro.props;
const content = loadContent();
const details = work.details!;
---
<Layout content={content} title={work.title} description={work.summary}>
  <main id="main" class="showcase">
    <div id="top" class="showcase-intro"><a class="text-link" href={sitePath(`#${work.placement}`)}>← Back to {work.placement === 'selected' ? 'selected work' : 'projects'}</a><p class="eyebrow">{work.type} · {work.year}</p><h1>{work.title}</h1><p class="intro">{work.summary}</p><ul class="tags" aria-label="Technologies">{work.technologies.map((tool) => <li>{tool}</li>)}</ul>{(work.source || work.demo) && <div class="showcase-links">{work.demo && <a class="button" href={work.demo}>Open app ↗</a>}{work.source && <a class="text-link" href={work.source}>View source ↗</a>}</div>}</div>
    {details.screenshot && <figure class="project-screenshot"><img src={sitePath(details.screenshot.src)} alt={details.screenshot.alt} width="1000" height="580" loading="lazy" /><figcaption>{details.screenshot.alt}</figcaption></figure>}
    {details.pipeline && <Pipeline pipeline={details.pipeline} />}
    <div class="case-sections">{[{ label: 'The problem', text: details.problem }, { label: 'My contribution', text: details.contribution }, { label: 'The tradeoff', text: details.tradeoff }, { label: 'The outcome', text: details.outcome }].map((item, i) => <section class="resume-section"><div class="section-rail"><span class="section-number">0{i + 1}</span><h2>{item.label}</h2></div><div class="section-content"><p>{item.text}</p></div></section>)}</div>
  </main>
</Layout>
