{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "types": ["node"], "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "src/lib/**/*.ts", "playwright.config.ts"]
}
